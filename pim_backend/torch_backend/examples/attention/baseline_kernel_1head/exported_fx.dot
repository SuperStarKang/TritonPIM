digraph FX {
rankdir=LR;
node [shape=box];
"b_mask" [label="b_mask\nplaceholder: b_mask"];
"query" [label="query\nplaceholder: query"];
"key" [label="key\nplaceholder: key"];
"value" [label="value\nplaceholder: value"];
"select" [label="select\ncall_function: aten.select.int"];
"query" -> "select";
"select_1" [label="select_1\ncall_function: aten.select.int"];
"key" -> "select_1";
"t" [label="t\ncall_function: aten.t.default"];
"select_1" -> "t";
"contiguous" [label="contiguous\ncall_function: aten.contiguous.default"];
"t" -> "contiguous";
"_int_mm" [label="_int_mm\ncall_function: aten._int_mm.default\n{\"operation\": \"QK^T\", \"mnk\": [1024, 1024, 128], \"weight\": null, \"padded_mnk\": [1024, 1024, 128], \"config\": {\"block_m\": 16, \"block_n\": 16, \"block_k\": 32, \"group_m\": 1, \"group_n\": 1, \"group_k\": 1, \"tile_m\": 2, \"tile_n\": 1, \"tile_k\": 4, \"p_m\": 32, \"p_n\": 64, \"p_k\": 1}}"];
"select" -> "_int_mm";
"contiguous" -> "_int_mm";
"_assert_tensor_metadata_default" [label="_assert_tensor_metadata_default\ncall_function: aten._assert_tensor_metadata.default"];
"_int_mm" -> "_assert_tensor_metadata_default";
"to" [label="to\ncall_function: aten.to.dtype"];
"_int_mm" -> "to";
"mul" [label="mul\ncall_function: aten.mul.Tensor"];
"to" -> "mul";
"masked_fill" [label="masked_fill\ncall_function: aten.masked_fill.Scalar"];
"mul" -> "masked_fill";
"b_mask" -> "masked_fill";
"softmax" [label="softmax\ncall_function: aten.softmax.int"];
"masked_fill" -> "softmax";
"amax" [label="amax\ncall_function: aten.amax.default"];
"softmax" -> "amax";
"div" [label="div\ncall_function: aten.div.Tensor"];
"amax" -> "div";
"div_1" [label="div_1\ncall_function: aten.div.Tensor"];
"softmax" -> "div_1";
"div" -> "div_1";
"round_1" [label="round_1\ncall_function: aten.round.default"];
"div_1" -> "round_1";
"clamp" [label="clamp\ncall_function: aten.clamp.default"];
"round_1" -> "clamp";
"_assert_tensor_metadata_default_1" [label="_assert_tensor_metadata_default_1\ncall_function: aten._assert_tensor_metadata.default"];
"clamp" -> "_assert_tensor_metadata_default_1";
"to_1" [label="to_1\ncall_function: aten.to.dtype"];
"clamp" -> "to_1";
"select_2" [label="select_2\ncall_function: aten.select.int"];
"value" -> "select_2";
"_int_mm_1" [label="_int_mm_1\ncall_function: aten._int_mm.default\n{\"operation\": \"PV\", \"mnk\": [1024, 128, 1024], \"weight\": null, \"padded_mnk\": [1024, 128, 1024], \"config\": {\"block_m\": 16, \"block_n\": 4, \"block_k\": 32, \"group_m\": 1, \"group_n\": 1, \"group_k\": 1, \"tile_m\": 1, \"tile_n\": 1, \"tile_k\": 32, \"p_m\": 64, \"p_n\": 32, \"p_k\": 1}}"];
"to_1" -> "_int_mm_1";
"select_2" -> "_int_mm_1";
"_assert_tensor_metadata_default_2" [label="_assert_tensor_metadata_default_2\ncall_function: aten._assert_tensor_metadata.default"];
"_int_mm_1" -> "_assert_tensor_metadata_default_2";
"to_2" [label="to_2\ncall_function: aten.to.dtype"];
"_int_mm_1" -> "to_2";
"mul_1" [label="mul_1\ncall_function: aten.mul.Tensor"];
"to_2" -> "mul_1";
"div" -> "mul_1";
"mul_2" [label="mul_2\ncall_function: aten.mul.Tensor"];
"mul_1" -> "mul_2";
"stack" [label="stack\ncall_function: aten.stack.default"];
"mul_2" -> "stack";
"output" [label="output\noutput: output"];
"stack" -> "output";
}
